# Copy to ~/.config/hrhsa/coolmuc4.env and adapt locally.
# The file is sourced by the benchmark batch scripts after LRZ's --export=NONE.
# coolmuc4_common.sh automatically loads LRZ's `micromamba` module when no
# private Miniforge/Mambaforge installation is present, then activates this env.

export HRHSA_CONDA_ENV="hsa"

# After running benchmarking/scripts/01_python/probe_coolmuc4.py inside a compute-node
# allocation, set this to the interface carrying CoolMUC-4 inter-node Dask traffic
# if appropriate. Example only -- do not assume the interface is named ib0.
export HRHSA_DASK_INTERFACE=""

# Optional storage overrides; defaults use $SCRATCH_DSS. These paths are captured
# in planner-driven run manifests so performance records retain their I/O context.
# export HRHSA_DATA_ROOT="$SCRATCH_DSS/hrhsa-benchmark-medium"
# export HRHSA_LARGE_DATA_ROOT="$SCRATCH_DSS/hrhsa-benchmark-large"
# export HRHSA_RESULT_ROOT="$SCRATCH_DSS/hrhsa-benchmark-results"
